#!/usr/bin/env bash
#Configure HAProxy to be able to accept requests on port tcp/80 and redirect them to the web servers
sudo apt update -y
sudo apt install haproxy -y
config=\
"backend my_servers
        balance roundrobin
        server 7173-web-01 13.219.76.107:80 check
        server 7173-web-02 44.204.87.91:80 check
frontend haproxy_inbound
        bind *:80
        default_backend my_servers
        mode http
"

sudo chown -R "$USER":"$USER" /etc/default/haproxy
sudo chown -R "$USER":"$USER" /etc/haproxy/haproxy.cfg
sudo tee -a "ENABLED=1" >> /etc/default/haproxy
sudo tee -a "$config" >> /etc/haproxy/haproxy.cfg
sudo systemctl enable haproxy
sudo service haproxy start
